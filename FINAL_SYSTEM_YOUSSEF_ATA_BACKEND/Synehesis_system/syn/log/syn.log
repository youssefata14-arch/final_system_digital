close $fh
foreach file [split $rtl "\n"] {

    set file [string trim $file]

    if {$file == ""} {
        continue
    }

    if {[string match "*.v" $file]} {
        analyze -format verilog $file
    } elseif {[string match "*.sv" $file]} {
        analyze -format sv $file
    } else {
        puts "WARNING: Unknown file format -> $file"
    }
}
