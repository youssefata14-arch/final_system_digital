set sdc_version 1.4
current_design SYS_TOP_dft
create_clock [get_ports {UART_CLK}]  -name UART_CLK -period 271.27 -waveform {0 135.635}
create_clock [get_ports {scan_clk}]  -name scan_clk -period 200 -waveform {0 100}
set_clock_latency -min 0 [get_clocks {scan_clk}]
set_clock_latency -max 0 [get_clocks {scan_clk}]
