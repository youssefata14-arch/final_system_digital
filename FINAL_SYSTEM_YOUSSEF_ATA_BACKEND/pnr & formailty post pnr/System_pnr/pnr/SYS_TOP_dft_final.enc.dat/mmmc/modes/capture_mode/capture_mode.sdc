set_output_delay -add_delay 40 -clock [get_clocks {scan_clk}] [get_ports {SO[1]}]
set_output_delay -add_delay 54.254 -clock [get_clocks {TX_CLK}] [get_ports {UART_TX_O}]
set_output_delay -add_delay 54.254 -clock [get_clocks {RX_CLK}] [get_ports {parity_error}]
