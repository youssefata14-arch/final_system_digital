read_file -type hdl ../rtl/FIFO_RD.v
read_file -type hdl ../rtl/FIFO_WR.v
read_file -type hdl ../rtl/FSM.sv
read_file -type hdl ../rtl/FSM_tx.sv
read_file -type hdl ../rtl/MUX.v
