read_file -type hdl ../rtl/CLK_GATE.v
read_file -type hdl ../rtl/CLOCK_DIV_MUX.v
read_file -type hdl ../rtl/Data_Sampling.v
read_file -type hdl ../rtl/DATA_SYNC.v
read_file -type hdl ../rtl/Deserializer.v
read_file -type hdl ../rtl/DF_SYNC.v
read_file -type hdl ../rtl/edge_bit_counter.v
